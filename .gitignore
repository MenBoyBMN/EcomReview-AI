# Environment & secrets
.env
*.env

# Raw data & sensitive assets
data/raw/*
!data/raw/.gitkeep
data/cache/*
!data/cache/.gitkeep

# Python Virtual Environment
.venv/
venv/
ENV/

# Python bytecode & cache
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Build & packaging
build/
dist/
*.egg-info/
*.egg

# Model checkpoints & large binary weights
models/*.pt
models/*.bin
models/*.safetensors
models/*.joblib
models/*.onnx
!models/.gitkeep

# Logs & Traces
results/traces/*
!results/traces/.gitkeep
*.log

# Temporary office and editor locks
~$*
*.tmp
Abount_System/*
