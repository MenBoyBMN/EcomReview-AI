# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration (PostgreSQL 16 & Local SQLite)
# Set ECOMREVIEW_DB_BACKEND to 'sqlite' for local development or 'postgres' for production Docker
ECOMREVIEW_DB_BACKEND=sqlite
ECOMREVIEW_SQLITE_PATH=data/ecomreview.db
DATABASE_URL=postgresql://ecom_user:ecom_password@localhost:5432/ecomreview
DATABASE_URL_RO=postgresql://ecom_agent_ro:agent_readonly_pass@localhost:5432/ecomreview
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ecom_password
POSTGRES_DB=ecomreview
DEMO_CACHE_MODE=true

# API Security & Authentication (Leave empty to disable authentication in dev mode)
ECOMREVIEW_API_KEY=
ECOMREVIEW_CORS_ORIGINS=*

# Local AI Engine (Addon 11 - Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Application Configuration
APP_ENV=development
LOG_LEVEL=INFO

