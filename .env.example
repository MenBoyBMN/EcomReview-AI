# Runtime Environment ('development' or 'production')
ECOMREVIEW_ENV=development
ECOMREVIEW_LOG_JSON=false
VITE_APP_MODE=production

# Google Gemini API Key & Agent LLM Controls
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MODEL_POOL=gemini-2.5-flash,gemini-2.5-flash-lite
ECOMREVIEW_AGENT_LLM=false
ECOMREVIEW_LLM_ENGINE=gemini

# Database Configuration (PostgreSQL 16 & Local SQLite)
ECOMREVIEW_DB_BACKEND=sqlite
ECOMREVIEW_SQLITE_PATH=data/ecomreview.db
DATABASE_URL=postgresql://ecom_user:ecom_password@localhost:5432/ecomreview
DATABASE_URL_RO=postgresql://ecom_agent_ro:change_me_readonly_pass@localhost:5432/ecomreview
POSTGRES_USER=ecom_user
POSTGRES_PASSWORD=ecom_password
POSTGRES_RO_PASSWORD=change_me_readonly_pass
POSTGRES_DB=ecomreview
DEMO_CACHE_MODE=true

# Durable Job Queue & Rate Limiter (Redis)
REDIS_URL=redis://localhost:6379/0
ECOMREVIEW_LLM_CACHE_TTL_SEC=604800
ECOMREVIEW_ANALYSIS_WORKERS=6
ECOMREVIEW_DB_BATCH_SIZE=100
ECOMREVIEW_TENANT_MAX_JOBS_PER_MIN=15
ECOMREVIEW_METRICS_TOKEN=
SENTRY_DSN=

# API Security & JWT Authentication (Required >=32 chars when ECOMREVIEW_ENV=production)
ECOMREVIEW_JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
# At-rest secret encryption key (Required valid Fernet key when ECOMREVIEW_ENV=production;
# generate via: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ECOMREVIEW_ENCRYPTION_KEY=
ECOMREVIEW_COOKIE_SECURE=false
ECOMREVIEW_API_KEY=
ECOMREVIEW_CORS_ORIGINS=http://localhost:5173

# Outbound Proactive Alerts (Optional global fallback; can be configured per shop in UI)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ECOMREVIEW_ALERT_WEBHOOK_URL=

# Optional Two-Way Marketplace Partner Credentials (Shopee / TikTok Shop)
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_SHOP_ID=
SHOPEE_ACCESS_TOKEN=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=
TIKTOK_SHOP_CIPHER=
TIKTOK_ACCESS_TOKEN=

# Local AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Paths & Lexicon Runtime Options
ECOMREVIEW_TRACE_DIR=results/traces
ECOMREVIEW_DISABLE_LEXICON_AUTOLOAD=false

# CreBy: MenBoyBMN
